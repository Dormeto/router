{
  "detail-type": ["AWS API Call via CloudTrail"],
  "$or": [
    {
      "source": ["aws.elasticloadbalancing"],
      "detail": {
        "eventName": ["ModifyRule", "CreateRule", "DeleteRule", "SetRulePriorities", "DeleteTargetGroup"],
        "userIdentity": { "arn": [{ "anything-but": { "prefix": "arn:${partition}:sts::${account}:assumed-role/${name}-" } }] },
        "errorCode": [{ "exists": false }]
      }
    },
    {
      "source": ["aws.elasticloadbalancing"],
      "detail": {
        "eventName": ["RemoveTags"],
        "requestParameters": { "tagKeys": ["dormeto:workload"] },
        "userIdentity": { "arn": [{ "anything-but": { "prefix": "arn:${partition}:sts::${account}:assumed-role/${name}-" } }] },
        "errorCode": [{ "exists": false }]
      }
    },
    {
      "source": ["aws.ec2"],
      "detail": {
        "eventName": ["DeleteTags"],
        "requestParameters": { "tagSet": { "items": { "key": ["dormeto:workload"] } } },
        "userIdentity": { "arn": [{ "anything-but": { "prefix": "arn:${partition}:sts::${account}:assumed-role/${name}-" } }] },
        "errorCode": [{ "exists": false }]
      }
    },
    {
      "source": ["aws.autoscaling"],
      "detail": {
        "eventName": ["DeleteTags"],
        "requestParameters": { "tags": { "key": ["dormeto:workload"] } },
        "userIdentity": { "arn": [{ "anything-but": { "prefix": "arn:${partition}:sts::${account}:assumed-role/${name}-" } }] },
        "errorCode": [{ "exists": false }]
      }
    },
    {
      "source": ["aws.ecs", "aws.rds"],
      "detail": {
        "eventName": ["UntagResource", "RemoveTagsFromResource"],
        "requestParameters": { "tagKeys": ["dormeto:workload"] },
        "userIdentity": { "arn": [{ "anything-but": { "prefix": "arn:${partition}:sts::${account}:assumed-role/${name}-" } }] },
        "errorCode": [{ "exists": false }]
      }
    }
  ]
}
